{
  "name": "@jimmy.codes/eslint-config",
  "version": "9.0.0",
  "description": "A simple, modern ESLint config that covers most use cases.",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "nextjs",
    "astro",
    "vitest",
    "tanstack-query",
    "react-compiler",
    "modern",
    "opinionated",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmy-guzman/eslint-config.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./globs": {
      "types": "./dist/globs.d.mts",
      "default": "./dist/globs.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typegen && tsdown",
    "coverage": "vitest run --coverage",
    "dev": "eslint-config-inspector --open=false",
    "docs:build": "eslint-config-inspector build",
    "format": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "prepack": "pnpm build && clean-pkg-json",
    "prepare": "is-ci || lefthook install",
    "test": "vitest",
    "typecheck": "tsc",
    "typegen": "tsx scripts/typegen.ts"
  },
  "prettier": "@jimmy.codes/prettier-config",
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@types/eslint": "9.6.1",
    "@typescript-eslint/parser": "^8.62.0",
    "@typescript-eslint/utils": "^8.62.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "astro-eslint-parser": "^2.1.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-de-morgan": "^2.1.2",
    "eslint-plugin-erasable-syntax-only": "0.4.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jest-dom-ya": "^1.0.1",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-dom": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-naming-convention": "^5.10.0",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-react-rsc": "^5.10.0",
    "eslint-plugin-react-web-api": "^5.10.0",
    "eslint-plugin-react-x": "^5.10.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-storybook": "0.12.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.7.0",
    "local-pkg": "^1.2.1",
    "typescript-eslint": "^8.62.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.1.0",
    "@eslint/config-inspector": "3.0.4",
    "@jimmy.codes/prettier-config": "2.1.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.9",
    "clean-pkg-json": "2.0.0",
    "commitlint": "21.1.0",
    "eslint": "10.6.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-typegen": "2.3.1",
    "gitzy": "7.2.2",
    "is-ci": "4.1.0",
    "jiti": "2.7.0",
    "knip": "6.23.0",
    "lefthook": "2.1.9",
    "prettier": "3.9.1",
    "publint": "0.3.21",
    "tsdown": "0.22.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "eslint": ">=10"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
